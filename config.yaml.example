# 复制为 config.yaml 按需覆盖（config.yaml 已 gitignore）。全部键见 server/config.py。

# port: 8698
# asr_backend: whispercpp     # 当前推荐：本地 whisper.cpp Metal；doubao 已废弃（空结果）
# asr_model: small            # 省内存档（默认 large-v3-turbo，约多占 1GB）
# tts_backend: auto           # auto=kokoro 优先，edge-tts 兜底；kokoro=强制本地；edge=强制云端
# tts_voice: zh-CN-YunxiNeural  # edge-tts 男声；默认 zh-CN-XiaoxiaoNeural
# kokoro_voice: zf_001        # kokoro 音色（zf_001=普通话女声）
# tts_rate: "+8%"             # edge-tts 语速；kokoro 用 kokoro_speed
# vad_end_silence_ms: 800     # 默认 800（原 1200）；想更快接话可降到 500，误切升高
# voice_system_prompt: 自定义语音风格提示……
