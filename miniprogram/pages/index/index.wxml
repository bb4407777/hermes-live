<view class="page">
  <!-- 固定头部：topbar + controls + 语音球，不随对话滚动 -->
  <view class="header-fixed">
    <!-- 第一行：标题 + 状态 + 快捷按钮 -->
    <view class="topbar">
      <text class="title">哈尔密斯</text>
      <text class="status">{{stateLabel}}</text>
      <view class="dot {{connected ? 'on' : ''}}"></view>
      <view class="spacer"></view>
      <view class="icon-btn" bindtap="newSession">↺</view>
      <view class="icon-btn" bindtap="openSetup">⚙</view>
    </view>

    <!-- 第二行：音色 + 语速 -->
    <view class="controls">
      <picker class="picker-wrap" mode="selector" range="{{voiceLabels}}" value="{{voiceIdx}}" bindchange="onVoiceChange">
        <view class="picker-btn">{{voiceLabels[voiceIdx]}} ▾</view>
      </picker>
      <picker class="picker-wrap" mode="selector" range="{{rateLabels}}" value="{{rateIdx}}" bindchange="onRateChange">
        <view class="picker-btn">{{rateLabels[rateIdx]}} ▾</view>
      </picker>
    </view>

    <!-- 语音球 + 状态标签 -->
    <view class="orb-area">
      <view class="orb-wrap" bindtap="toggle">
        <view class="orb {{state}}"></view>
      </view>
      <text class="orb-label">{{running ? '点击停止' : '点击开始'}}</text>
    </view>
  </view>

  <!-- 对话记录（实时字幕作为最后一条临时气泡渲染在此） -->
  <scroll-view class="transcript" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view wx:for="{{messages}}" wx:key="id" id="m{{item.id}}" class="bubble {{item.cls}}">{{item.text}}</view>
    <!-- 实时转写：显示为用户侧半透明气泡，VAD 结束后由 asr_final 替换为正式气泡 -->
    <view wx:if="{{partialText}}" id="partial-bubble" class="bubble user partial">{{partialText}}</view>
    <view class="pad"></view>
  </scroll-view>

  <!-- 文字输入 -->
  <view class="footer">
    <input class="textin" value="{{textIn}}" bindinput="onInput" bindconfirm="sendText"
           confirm-type="send" placeholder="打字发送…" placeholder-class="ph"
           adjust-position="true"/>
    <view class="send-btn" bindtap="sendText">发送</view>
  </view>

  <!-- 设置弹窗 -->
  <view class="mask" wx:if="{{showSetup}}" catchtap="noop">
    <view class="dialog" catchtap="noop">
      <view class="dtitle">连接设置</view>
      <view class="dlabel">服务器地址</view>
      <input class="dinput" value="{{server}}" bindinput="onServerInput"
             placeholder="wss://live.gaochengbin.com" placeholder-class="ph"/>
      <view class="dlabel">Token（留空即可）</view>
      <input class="dinput" value="{{token}}" bindinput="onTokenInput"
             placeholder="auth_token（默认不需要）" placeholder-class="ph"/>
      <view class="dtip">默认走 Cloudflare Tunnel（wss://live.gaochengbin.com），家里 WiFi 可改 ws://192.168.5.50:8698</view>
      <view class="drow">
        <view class="dcancel" bindtap="cancelSetup">取消</view>
        <view class="dsave" bindtap="saveSetup">保存连接</view>
      </view>
    </view>
  </view>
</view>
