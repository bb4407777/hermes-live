/* 与 web/index.html 同一套配色变量 */
page { background: #0d1117; color: #e6edf3; height: 100%; box-sizing: border-box; }
.page { display: flex; flex-direction: column; height: 100vh; }

/* 固定头部：topbar + controls + 语音球 */
.header-fixed {
  flex-shrink: 0;
  background: #0d1117;
  border-bottom: 1rpx solid #21262d;
}

/* 顶栏 */
.topbar { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 28rpx 12rpx; }
.title  { font-size: 30rpx; font-weight: 600; }
.status { font-size: 24rpx; color: #8b949e; }
.dot    { width: 14rpx; height: 14rpx; border-radius: 50%; background: #30363d; }
.dot.on { background: #2ea043; }
.spacer { flex: 1; }
.icon-btn { font-size: 36rpx; color: #8b949e; padding: 4rpx 12rpx; }

/* 控件行：音色 / 语速 / 重启 */
.controls { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 24rpx; border-top: 1rpx solid #21262d; }
.picker-wrap { display: inline-block; }
.picker-btn  { background: #161b22; color: #e6edf3; border: 1rpx solid #21262d; border-radius: 10rpx;
               padding: 8rpx 18rpx; font-size: 24rpx; white-space: nowrap; }
.ctrl-btn    { background: #161b22; color: #e6edf3; border: 1rpx solid #21262d; border-radius: 10rpx;
               padding: 8rpx 18rpx; font-size: 24rpx; white-space: nowrap; }
.ctrl-btn.dim { color: #444d56; border-color: #21262d; }
.restart-btn { background: #da3633; color: #fff; border: 1rpx solid #f85149; border-radius: 10rpx;
               padding: 8rpx 18rpx; font-size: 24rpx; white-space: nowrap; margin-left: auto; }

/* 语音球 */
.orb-area  { position: relative; display: flex; flex-direction: column; align-items: center; padding: 24rpx 0 18rpx; border-top: 1rpx solid #21262d; }
.orb-wrap  { width: 160rpx; height: 160rpx; display: flex; align-items: center; justify-content: center; }
.orb {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: radial-gradient(circle at 32% 30%, #d977ff, #bc5cff 75%);
  filter: saturate(.35) brightness(.5); transition: filter .3s;
}
.orb.listening { background: radial-gradient(circle at 32% 30%, #58a6ff, #1f6feb 75%); filter: none; box-shadow: 0 0 60rpx #58a6ff55; }
.orb.thinking  { filter: none; animation: breathe 1.4s ease-in-out infinite; }
.orb.speaking  { filter: none; animation: breathe .9s ease-in-out infinite; box-shadow: 0 0 70rpx #bc8cff66; }
@keyframes breathe { 50% { transform: scale(1.08); } }
.orb-label { font-size: 22rpx; color: #8b949e; margin-top: 12rpx; }
/* 绝对定位：只在 thinking/speaking 出现，不占流内高度，避免头部忽高忽低 */
.interrupt-btn { position: absolute; right: 32rpx; bottom: 26rpx; background: #da3633; color: #fff;
                 border: 1rpx solid #f85149; border-radius: 999rpx; padding: 12rpx 28rpx;
                 font-size: 24rpx; line-height: 1.2; }

/* 对话记录 */
.transcript { flex: 1; height: 0; padding: 16rpx 24rpx; box-sizing: border-box; }
.bubble { max-width: 84%; padding: 14rpx 22rpx; border-radius: 18rpx; margin: 10rpx 0;
          font-size: 28rpx; line-height: 1.55; word-break: break-all; white-space: pre-wrap; }
.bubble.user  { background: #1f6feb; margin-left: auto; }
.bubble.agent { background: #161b22; border: 1rpx solid #21262d; margin-right: auto; }
.bubble.tool  { color: #8b949e; font-size: 24rpx; background: none; padding: 0 8rpx; }
.bubble.error { color: #f85149; font-size: 24rpx; background: none; margin: 10rpx auto; }
/* 实时转写气泡：跟用户气泡同侧，半透明斜体表示"正在说" */
.bubble.partial { opacity: .55; font-style: italic; }
.pad { height: 16rpx; }

/* 文字输入 */
.footer   { display: flex; gap: 14rpx; padding: 14rpx 24rpx; align-items: center; border-top: 1rpx solid #21262d; flex-shrink: 0; }
.textin   { flex: 1; background: #161b22; border: 1rpx solid #21262d; border-radius: 12rpx;
            padding: 14rpx 20rpx; font-size: 28rpx; color: #e6edf3; min-width: 0; }
.ph       { color: #8b949e; }
.send-btn { background: #1f6feb; color: #fff; border-radius: 12rpx;
            padding: 14rpx 28rpx; font-size: 28rpx; white-space: nowrap; }

/* 设置弹窗 */
.mask    { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.7);
           display: flex; align-items: center; justify-content: center; z-index: 999; }
.dialog  { width: 86%; background: #161b22; border: 1rpx solid #30363d; border-radius: 24rpx; padding: 36rpx; }
.dtitle  { font-size: 32rpx; font-weight: 600; margin-bottom: 28rpx; }
.dlabel  { font-size: 24rpx; color: #8b949e; margin-bottom: 10rpx; }
.dinput  { background: #0d1117; border: 1rpx solid #30363d; border-radius: 12rpx;
           padding: 16rpx 20rpx; font-size: 26rpx; color: #e6edf3; margin-bottom: 20rpx; display: block; }
.dtip    { font-size: 22rpx; color: #6e7681; margin-bottom: 28rpx; line-height: 1.5; }
.drow    { display: flex; gap: 16rpx; }
.dcancel { flex: 1; background: #21262d; color: #8b949e; border-radius: 12rpx; padding: 18rpx 0; font-size: 28rpx; text-align: center; }
.dsave   { flex: 2; background: #238636; color: #fff; border-radius: 12rpx; padding: 18rpx 0; font-size: 28rpx; text-align: center; }
